{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mafer-audio-intelligence",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "AUDIO_RATE_LIMITER",
      "namespace_id": "281108",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
